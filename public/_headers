# Cabeceras de seguridad para Cloudflare Pages o Netlify.
# Ajusta la CSP cuando conectes servicios: añade sus dominios en frame-src / connect-src / form-action.
# script-src lleva 'unsafe-inline' porque React Router incrusta un script de hidratación en cada página;
# cuando el sitio esté estable puedes cambiarlo por los hashes de esos scripts.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; frame-src https://www.youtube-nocookie.com https://open.spotify.com https://cal.com; connect-src 'self' https://formspree.io; form-action 'self' https://formspree.io; base-uri 'self'; object-src 'none'
